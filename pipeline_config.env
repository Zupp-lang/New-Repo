# ── TANF Childcare Pipeline Configuration ───────────────────────────
# Parsed by Python (01_extract.py) and R (02/03/04/05 scripts).
# Format: KEY=VALUE (no quotes needed, no spaces around =).
 
# ── Paths ───────────────────────────────────────────────────────────
BASE_DIR=D:/xeoga/Downloads
CLEAN_EXTRACT_TEMPLATE=pu{year}_clean.csv
ANNUAL_PANEL_FILE=hh_annual_2018_2023.csv
 
# ── Years to process ────────────────────────────────────────────────
YEARS=2014,2015,2016,2017,2018,2019,2020,2021,2022,2023
 
# ── Year exclusions (COVID contamination, applied after panel build) ─
# Comma-separated calendar years to drop from analysis.
# 2020: pandemic disrupted childcare markets, triggered emergency TANF
# extensions, and confounded treatment timing.
EXCLUDE_YEARS=2020
 
# ── Sample delineation ──────────────────────────────────────────────
# "ever_tanf"      : TTANF_AMT > 0 in any person-month (broad, DEFAULT)
# "lifetime_limit" : TTANF_ERSN == 3 or RTANF_LCYR == 3 (original, sensitivity)
SAMPLE_MODE=ever_tanf
 
# ── Outcome configuration ───────────────────────────────────────────
PRIMARY_OUTCOME=EPAY
SECONDARY_OUTCOMES=TPAYWK,TPAYWK_ASINH,EDAYCARE,EFAM,EGRAN,ENREL,ELIST,EWORKMORE
 
# ── Treatment states and onset years ────────────────────────────────
# Format: STATE_FIPS:ONSET_YEAR (comma-separated)
# CA=6, CT=9, DE=10, RI=44
TREAT_STATE_ONSET=6:2021,9:2021,10:2021,44:2022
 
# ── Regression controls (NO lag variables) ──────────────────────────
CONTROLS=ERN,WRTH,N_children,TMWKHRS_SUM_PARENTS,HHMAXEEDUC_HS
 
# ── Balancing / robustness methods ──────────────────────────────────
# Methods to run (comma-separated). Each produces tagged outputs.
# Options: none, synthetic_control, overlap_trim
# "none" = unweighted baseline; "synthetic_control" = state-year SCM
# matching treated pre-period outcomes/predictors to donor states;
# "overlap_trim" = drop obs outside common propensity support.
BALANCE_METHODS=none,synthetic_control,overlap_trim
 
# ── Balance diagnostics ─────────────────────────────────────────────
# Covariates for balance table (pre-treatment SMD check)
BALANCE_COVARS=ERN,WRTH,N_children,TMWKHRS_SUM_PARENTS,HHMAXEEDUC_HS,PARENT_AGE_MEAN,KDAG,KD2,KD3,LK3,UN3,DIS3
# Absolute SMD threshold for post-weight imbalance warning
SMD_WARN_THRESHOLD=0.10
 
# ── Guardrail thresholds ───────────────────────────────────────────
MIN_HH_TOTAL=50
MIN_HH_TREATED=10
MIN_CLUSTERS=5
MIN_OUTCOME_NONMISSING_PCT=10
 
# ── Event study parameters ──────────────────────────────────────────
MAX_EVENT_ABS=3
REF_EVENT=-1
CHILD_AGE_MAX=13
PARENT_AGE_MIN=15
